# Audit trail backend. Default is an in-browser mock; flip to "true" to use the
# real FastAPI + SQLite service in ./audit-service.
VITE_USE_REAL_AUDIT=false
VITE_AUDIT_API_URL=http://localhost:8000

# Chart data source. "mock" uses the seeded John Doe fixture; "epic" is a future
# stub that will speak Epic FHIR R4.
VITE_CHART_SOURCE=mock
